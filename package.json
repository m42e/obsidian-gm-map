{
  "name": "gm-map",
  "version": "0.1.13",
  "description": "Show a TTRPG map to your players with DM-controlled fog of war, statblock-linked tokens, and DM-only markers.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "ttrpg",
    "map",
    "fog-of-war"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.21.0"
  }
}
